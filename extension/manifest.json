{
  "manifest_version": 3,
  "name": "xNhau Cloudflare Bypasser",
  "version": "1.0",
  "description": "Extension hỗ trợ vượt Cloudflare và mở khóa X-Frame-Options cho Tiktok UI Web.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://xtok-app.onrender.com/*", "*://localhost/*", "*://127.0.0.1/*", "*://*.xnhau.loan/*", "*://*.xnhau.tech/*", "*://*.xnhau.ink/*", "*://xnhau.ink/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "xNhau Bypasser"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
