[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "x-frame-options", "operation": "remove" },
        { "header": "content-security-policy", "operation": "remove" },
        { "header": "cross-origin-embedder-policy", "operation": "remove" },
        { "header": "cross-origin-opener-policy", "operation": "remove" },
        { "header": "cross-origin-resource-policy", "operation": "remove" },
        { "header": "access-control-allow-origin", "operation": "set", "value": "*" },
        { "header": "access-control-allow-methods", "operation": "set", "value": "GET, HEAD, POST, PUT, DELETE, OPTIONS" },
        { "header": "access-control-allow-headers", "operation": "set", "value": "Content-Type, Authorization, X-Requested-With, Range" }
      ]
    },
    "condition": {
      "urlFilter": "xnhau",
      "resourceTypes": ["sub_frame", "media", "xmlhttprequest", "other", "main_frame", "script", "image"]
    }
  }
]
